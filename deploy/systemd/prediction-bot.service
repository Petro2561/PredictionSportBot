[Unit]
Description=PredictionSportBot Telegram bot
After=network.target redis-server.service
Wants=redis-server.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/prediction-sport-bot
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/prediction-sport-bot/venv/bin/python main.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
