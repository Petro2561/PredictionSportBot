[Unit]
Description=PredictionSportBot SQLAdmin
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/prediction-sport-bot
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/prediction-sport-bot/venv/bin/uvicorn admin.main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
