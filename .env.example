BOT_TOKEN = your_bot_token_here
ADMIN_IDS =
# SQLAdmin — http://localhost:8000/admin
ADMIN_LOGIN = admin
ADMIN_PASSWORD = admin
ADMIN_SECRET_KEY = change-me-in-production
ADMIN_PORT = 8000
DEFAULT_TOURNAMENT_ID = 1
WEBAPP_URL = http://201.51.16.202:8082
WEBAPP_PORT = 8081
# Google Таблицы — сервисный аккаунт (рекомендуется)
GOOGLE_SERVICE_ACCOUNT_FILE = credentials/google-service-account.json
# Папка в вашем Drive, расшаренная на email сервисного аккаунта (Редактор)
# Нужна только при создании новой таблицы (если GOOGLE_SPREADSHEET_ID не задан)
GOOGLE_DRIVE_FOLDER_ID = your_folder_id_from_drive_url
# ID или URL существующей таблицы — бот будет обновлять её, а не создавать новую
# Расшарьте таблицу на email сервисного аккаунта (Редактор)
GOOGLE_SPREADSHEET_ID =
GOOGLE_SPREADSHEET_SHEET_NAME = Стадия 1
# Ваш Gmail — получите права редактора на каждую созданную таблицу
GOOGLE_SHEETS_SHARE_EMAIL = your@gmail.com
# true — создавать таблицу в любое время (для тестов)
GOOGLE_SHEETS_SKIP_DEADLINE = false